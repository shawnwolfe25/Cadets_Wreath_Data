// This tells Vercel to treat api/ as serverless functions
// and serve index.html for all other routes.
{
  "functions": {
    "api/proxy.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
