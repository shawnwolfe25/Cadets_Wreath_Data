// ===================== .env.example =====================
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN_HERE
WAA_PASS_ADMIN=choose-an-admin-password
WAA_PASS_READ=choose-a-read-only-password
# Optional: secret used to sign login sessions. If unset, one is derived from the passwords.
WAA_TOKEN_SECRET=long-random-string
